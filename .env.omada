# Eksempel på .env-fil for lokal kjøring
# Kopier denne filen til .env og fyll inn verdiene:
#   cp .env.example .env
#
# .env er i .gitignore og skal aldri committes.
# Hent verdiene fra Vault eller en kollega.

# ── Database ────────────────────────────────────────────────
APPS_USER=OMADA_API
APPS_PASSWORD=<passord>
DB_URL=<jdbc-url>

# ── PL/SQL ──────────────────────────────────────────────────
# Oracle operating unit ID — miljøspesifikk, hentes fra Vault
PLSQL_ORG_ID=<org_id>

# Prosedyrenavn — trenger normalt ikke endres
# PLSQL_INSERT_PROCEDURE=APPS.XXRTV_INT_OMADA_INSERT_MESSAGE.InsertOmadaMessage

# ── SCIM ────────────────────────────────────────────────────
# Base-URL for meta.location i SCIM-responser
SCIM_BASE_URL=http://localhost:8080

# ── Applikasjon ─────────────────────────────────────────────
OEBS_ENV=LOCAL

